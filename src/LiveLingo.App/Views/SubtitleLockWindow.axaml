<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LiveLingo.App.ViewModels" x:Class="LiveLingo.App.Views.SubtitleLockWindow" x:DataType="vm:DesktopViewModel"
        Title="LiveLingo 字幕锁定" Width="104" Height="40" CanResize="False"
        WindowDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False">
  <Button Name="LayoutLockButton" Content="{Binding LayoutActionText}" Command="{Binding ToggleLayoutCommand}"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center"
          Padding="8,4" FontSize="12" Background="#263747" Foreground="#9EDFC7"
          ToolTip.Tip="解锁后拖动顶部移动、拖动边缘缩放；锁定后字幕正文鼠标穿透" />
</Window>
