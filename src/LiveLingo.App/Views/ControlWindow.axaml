<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LiveLingo.App.ViewModels" xmlns:core="using:LiveLingo.Core.Desktop" xmlns:views="using:LiveLingo.App.Views"
        x:Class="LiveLingo.App.Views.ControlWindow" x:DataType="vm:DesktopViewModel" Classes="desktop"
        Title="LiveLingo" Width="960" Height="760" MinWidth="760" MinHeight="600">
  <Window.Styles><StyleInclude Source="avares://LiveLingo.App/Themes/DesktopTheme.axaml" /></Window.Styles>
  <Grid ColumnDefinitions="164,*">
    <Border Background="{DynamicResource DesktopSurface}" BorderBrush="{DynamicResource DesktopBorder}" BorderThickness="0,0,1,0" Padding="12,24">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="28">
        <StackPanel Margin="12,0" Spacing="6"><TextBlock Text="LiveLingo" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="本地实时翻译" Classes="caption" /></StackPanel>
        <ListBox Name="MainNavigation" Grid.Row="1" Classes="navigation" SelectedIndex="{Binding SelectedPageIndex}" VerticalAlignment="Top" AutomationProperties.Name="主要页面">
          <ListBoxItem Content="实时翻译" /><ListBoxItem Content="历史记录" /><ListBoxItem Content="设置" />
        </ListBox>
        <TextBlock Grid.Row="2" Margin="12,0" Text="音频、翻译留在本机" Classes="caption" />
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="12">
      <Border Classes="card" IsVisible="{Binding HasPendingSettings}" Padding="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding PendingSettingsText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource DesktopWarning}" /><Button Grid.Column="1" Content="前往设置" Command="{Binding OpenSettingsCommand}" /></Grid>
      </Border>
      <StackPanel Grid.Row="1" Spacing="8">
        <Border Classes="card" IsVisible="{Binding HasError}" Padding="12"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource DesktopDanger}" TextWrapping="Wrap" /></Border>
        <Border Classes="card" IsVisible="{Binding HistorySaveFailed}" Padding="12"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Text="{Binding HistorySaveMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DesktopDanger}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="重试保存记录" Command="{Binding Archive.RetrySaveCommand}" IsVisible="{Binding Archive.CanRetry}" /></Grid></Border>
      </StackPanel>
      <Grid Grid.Row="2">
        <Grid Name="LivePage" IsVisible="{Binding IsLivePage}" RowDefinitions="Auto,Auto,*" RowSpacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4"><TextBlock Text="实时翻译" Classes="pageTitle" /><TextBlock Text="选择正在播放声音的应用" Classes="caption" /></StackPanel>
            <Button Name="SessionButton" Grid.Column="1" Content="{Binding SessionButtonText}" IsEnabled="{Binding CanToggle}" Command="{Binding ToggleCommand}" Classes="primary" MinWidth="112" VerticalAlignment="Center" />
          </Grid>
          <Border Grid.Row="1" Classes="card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" AutomationProperties.Name="采集应用根进程">
                  <ComboBox.ItemTemplate><DataTemplate DataType="core:DesktopTarget"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="刷新采集应用" />
              </Grid>
              <TextBlock Text="包括应用的子进程；浏览器可能包含多个标签页。" Classes="caption" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Text="{Binding RuntimeSummary}" Classes="caption" VerticalAlignment="Center" /><Button Grid.Column="1" Content="更改" Command="{Binding OpenRuntimeSettingsCommand}" AutomationProperties.Name="更改模型与识别语言" /></Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Text="{Binding Backlog}" Classes="caption" /></Grid>
            </StackPanel>
          </Border>
          <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="当前会话" Classes="section" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="回到最新" IsVisible="{Binding IsReviewing}" Command="{Binding ResumeFollowingCommand}" /><Button Content="{Binding OverlayToggleText}" Command="{Binding ToggleOverlayCommand}" /></StackPanel>
            </Grid>
            <Border Grid.Row="1" Classes="card" Padding="0">
              <Grid>
                <StackPanel IsVisible="{Binding !HasLiveHistory}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Spacing="8">
                  <TextBlock Text="等待语音开始" FontSize="18" HorizontalAlignment="Center" /><TextBlock Text="开始翻译后，原文与译文会显示在这里。&#10;字幕可能随上下文继续修订。" Classes="caption" TextAlignment="Center" />
                </StackPanel>
                <ListBox Name="HistoryList" Classes="transcript" ItemsSource="{Binding History}" IsVisible="{Binding HasLiveHistory}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate><DataTemplate DataType="vm:SubtitleRow">
                    <StackPanel Spacing="8"><TextBlock Text="{Binding StatusText}" Classes="caption" /><TextBlock Text="{Binding Source}" TextWrapping="Wrap" Foreground="{DynamicResource DesktopSecondaryText}" /><TextBlock Text="{Binding Translation}" TextWrapping="Wrap" FontSize="19" /><Expander Header="详细信息" HorizontalAlignment="Stretch"><TextBlock Text="{Binding Detail}" Classes="caption" /></Expander></StackPanel>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
        </Grid>
        <Grid IsVisible="{Binding IsHistoryPage}"><views:HistoryView Name="ArchivePage" DataContext="{Binding Archive}" /></Grid>
        <views:SettingsView Name="SettingsPanel" IsVisible="{Binding IsSettingsPage}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
